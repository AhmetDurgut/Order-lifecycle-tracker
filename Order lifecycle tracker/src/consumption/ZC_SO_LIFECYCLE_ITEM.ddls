// =========================================================================
// View        : ZC_SO_LIFECYCLE_ITEM
// Purpose     : Sales Order Lifecycle Item - Consumption View (CDS View Entity)
// Layer       : Consumption (C_)
// Source      : ZI_SO_LIFECYCLE_ITEM_BASE
// Target      : S/4HANA
//
// Notes:
// - One row per sales order item. Stage and DaysInCurrentStage come
//   pre-computed from the item base view; only StageCriticality is
//   derived here, directly from DaysInCurrentStage (no repeated
//   day-count logic - see ZI_SO_LIFECYCLE_ITEM_BASE for the single
//   source of truth).
// - The _SalesOrder association points to ZC_SO_LIFECYCLE (the header
//   consumption view, not the interface base view) so the OData service
//   can expose a header -> item navigation for the Fiori Elements
//   Object Page.
// - StageCriticality uses Fiori criticality codes: 1 = red (negative),
//   2 = yellow (critical), 3 = green (positive). Same per-stage
//   thresholds as the header consumption view.
// - UI annotations live in a separate metadata extension
//   (ZC_SO_LIFECYCLE_ITEM, ddlx) layered on top of this view - hence
//   @Metadata.allowExtensions.
// - OrderQuantity/SalesUnit and ItemNetValue/Currency carry
//   @Semantics.quantity.unitOfMeasure / @Semantics.amount.currencyCode, so
//   Fiori Elements binds the unit and currency the item table's metadata
//   extension relies on instead of rendering plain numbers.
// =========================================================================

@AccessControl.authorizationCheck: #CHECK
@Metadata.allowExtensions: true
@EndUserText.label: 'Sales Order Lifecycle Item'
@VDM.viewType: #CONSUMPTION

define view entity ZC_SO_LIFECYCLE_ITEM
  as select from ZI_SO_LIFECYCLE_ITEM_BASE as LifecycleItem

  association [1..1] to ZC_SO_LIFECYCLE as _SalesOrder
    on $projection.SalesOrder = _SalesOrder.SalesOrder

{
  key SalesOrder,
  key SalesOrderItem,
      Material,
      ItemDescription,
      @Semantics.quantity.unitOfMeasure: 'SalesUnit'
      OrderQuantity,
      @Semantics.unitOfMeasure: true
      SalesUnit,
      @Semantics.amount.currencyCode: 'Currency'
      ItemNetValue,
      @Semantics.currencyCode: true
      Currency,
      Plant,
      ItemDeliveryStatus,
      ItemBillingStatus,
      ItemOverallStatus,
      CreationDate,
      LatestGoodsIssueDate,
      TotalDeliveredQuantity,
      LifecycleStage,
      DaysInCurrentStage,

      // -----------------------------------------------------------------
      // StageCriticality - Fiori criticality codes (1 = red, 2 = yellow,
      // 3 = green). Outer CASE selects the stage (already computed in
      // the base view), inner CASE applies the stage-specific day
      // thresholds to the already-computed DaysInCurrentStage - no
      // day-count recomputation needed here.
      // -----------------------------------------------------------------
      case
        // ORDER_CREATED: 0-1 green, 2-4 yellow, else red
        when LifecycleStage = 'ORDER_CREATED'
          then case
                 when DaysInCurrentStage <= 1 then cast( 3 as abap.int1 )
                 when DaysInCurrentStage <= 4 then cast( 2 as abap.int1 )
                 else cast( 1 as abap.int1 )
               end

        // PARTIALLY_DELIVERED: 0-2 green, 3-6 yellow, else red
        when LifecycleStage = 'PARTIALLY_DELIVERED'
          then case
                 when DaysInCurrentStage <= 2 then cast( 3 as abap.int1 )
                 when DaysInCurrentStage <= 6 then cast( 2 as abap.int1 )
                 else cast( 1 as abap.int1 )
               end

        // DELIVERED: 0 green, 1-2 yellow, else red
        when LifecycleStage = 'DELIVERED'
          then case
                 when DaysInCurrentStage = 0  then cast( 3 as abap.int1 )
                 when DaysInCurrentStage <= 2 then cast( 2 as abap.int1 )
                 else cast( 1 as abap.int1 )
               end

        // GOODS_ISSUED: 0-2 green, 3-6 yellow, else red
        when LifecycleStage = 'GOODS_ISSUED'
          then case
                 when DaysInCurrentStage <= 2 then cast( 3 as abap.int1 )
                 when DaysInCurrentStage <= 6 then cast( 2 as abap.int1 )
                 else cast( 1 as abap.int1 )
               end

        // PARTIALLY_INVOICED: 0-4 green, 5-9 yellow, else red
        when LifecycleStage = 'PARTIALLY_INVOICED'
          then case
                 when DaysInCurrentStage <= 4 then cast( 3 as abap.int1 )
                 when DaysInCurrentStage <= 9 then cast( 2 as abap.int1 )
                 else cast( 1 as abap.int1 )
               end

        // INVOICED: always green - lifecycle complete
        when LifecycleStage = 'INVOICED'
          then cast( 3 as abap.int1 )

        // UNKNOWN / anything else: default green (no signal to escalate on)
        else cast( 3 as abap.int1 )
      end                                  as StageCriticality,

      // expose association
      _SalesOrder
}
